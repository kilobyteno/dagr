# Canonical public origin used for Open Graph, sitemap, and JSON-LD.
# SITE_URL=https://www.dagr.no

# Optional. Raises the GitHub API rate limit. Required if the releases repo is private.
# GITHUB_TOKEN=

# GitHub owner/repo that publishes desktop installers (default kilobyteno/dagr).
# GITHUB_REPO=kilobyteno/dagr
