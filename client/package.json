{
  "name": "dagr",
  "version": "0.1.0",
  "private": true,
  "description": "Dagr desktop client",
  "author": "Kilobyte AS",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/apply-electron-icon-dev.mjs && node scripts/sign-electron-dev.mjs && vite",
    "dev:2": "node scripts/apply-electron-icon-dev.mjs && node scripts/dev-instance-2.mjs",
    "dev:web": "vite --mode web",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "package": "pnpm build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sign:dev": "node scripts/apply-electron-icon-dev.mjs && node scripts/sign-electron-dev.mjs",
    "postinstall": "node scripts/apply-electron-icon-dev.mjs && node scripts/sign-electron-dev.mjs"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
