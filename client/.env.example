# Required for @shadcnblocks Pro registry (shadcn CLI and MCP)
SHADCNBLOCKS_API_KEY=

# Dagr Cloud API base URL used when "Cloud" is selected on login/signup
# VITE_DAGR_CLOUD_URL=https://api.dagr.no

# Default self-hosted API URL (must match HTTP_ADDR in deploy/.env)
# VITE_DAGR_SELF_HOSTED_URL=http://localhost:8080

# Login tab when nothing is stored yet: cloud | selfhosted
# Unset: selfhosted in Vite dev, cloud in production builds
# VITE_DAGR_DEFAULT_MODE=selfhosted
