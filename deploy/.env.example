# Copy to deploy/.env or export before running compose / the server.

HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info
# Public web/app origin used in invite and email verification links.
PUBLIC_BASE_URL=http://localhost:4173
# Use 5433 when talking to Compose Postgres from the host (see docker-compose.yml).
DATABASE_URL=postgres://dagr:dagr@localhost:5433/dagr?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# REDIS_TLS=true
# REDIS_TLS_SKIP_VERIFY=true

# Auth password policy (sys admin). Exposed via GET /api/v1/public/config
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=false

# Opaque session lifetime (Go duration), default 30 days
SESSION_TTL=720h

# Transactional email (worker delivers asynq email:send tasks). Run `make worker-run`.
# EMAIL_PROVIDER: log (default) | smtp | lettermint
EMAIL_PROVIDER=log
EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=true
# LETTERMINT_API_TOKEN=
# LETTERMINT_BASE_URL=

# Federation / Connect identity (stable across restarts in production)
SERVER_ID=local-dev
SERVER_PUBLIC_URL=http://localhost:8080
# Base64 Ed25519 seed (32 bytes) or private key (64 bytes). Leave empty for ephemeral local keys.
# SERVER_SIGNING_PRIVATE_KEY=

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dagr
S3_USE_SSL=false
S3_REGION=us-east-1

# selfhosted (default, unlimited, no payments) or cloud
DEPLOYMENT_MODE=selfhosted
# BILLING_CURRENCY=EUR
# PRO_MONTHLY_CENTS=700
# YEARLY_DISCOUNT_PERCENT=10
# EARLY_ACCESS_ENABLED=true
# EARLY_ACCESS_MONTHS=3
# EARLY_ACCESS_PERCENT_OFF=50
# BILLING_GRACE_PERIOD=168h
# Cloud only. Leave unset on self-hosted.
# MOLLIE_API_KEY=
# MOLLIE_PROFILE_ID=
# MOLLIE_WEBHOOK_URL=
